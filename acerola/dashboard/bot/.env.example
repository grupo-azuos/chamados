# ─────────────────────────────────────────────────────────────────────────────
# Bot de WhatsApp — copie para `.env` (que nunca vai para o git) e preencha.
# ─────────────────────────────────────────────────────────────────────────────

# Onde o bot escuta. Só a máquina local por padrão: quem fala com ele é o servidor, nunca a
# internet. No Docker o compose troca para 0.0.0.0, dentro da rede interna.
BOT_HOST=127.0.0.1
BOT_PORT=4005

# O segredo que o servidor apresenta em toda chamada (mínimo de 32 caracteres). Quem tem este
# valor manda mensagem pelo WhatsApp de qualquer pessoa vinculada. O mesmo valor vai no servidor.
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BOT_API_TOKEN=

# A chave que cifra as conexões guardadas em disco: AES-256, 64 caracteres hexadecimais.
# PERMANENTE por instalação — trocar a chave invalida todos os vínculos (todo mundo relê o QR code).
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BOT_SESSION_KEY=

# Onde as conexões cifradas ficam. Em produção, um volume.
BOT_DATA_DIR=./data

# fatal | error | warn | info | debug | trace | silent
BOT_LOG_LEVEL=info
