# Variáveis do client. Este arquivo é versionado; o `.env` ao lado nunca.
#
# TUDO AQUI É PÚBLICO: o que tem prefixo `VITE_` entra no bundle, e qualquer pessoa que
# abrir o site consegue ler. Chave de API, senha, token: NUNCA aqui. Segredo mora no
# `server/.env`, e a separação por arquivo é o que torna o engano impossível.
#
# Nada além da porta é obrigatório em desenvolvimento: a web fala com `/api` no mesmo host e
# o Vite encaminha para o Nest.

# Porta local da interface.
VITE_PORT=4001

# Porta do server.
VITE_API_PORT=3005

# Endereço da API no build de produção. Vazio = mesma origem (o server serve o client).
VITE_API_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Login — admin-console
# ─────────────────────────────────────────────────────────────────────────────
# Nada aqui: a tela não faz login. Quem identifica a pessoa é o admin-console, pelo
# proxy, e o endereço da conta dela vem da API (ver ADMIN_CONSOLE_LOGIN_URL no
# server/.env.example).
