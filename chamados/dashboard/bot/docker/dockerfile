# syntax=docker/dockerfile:1
# Rspack empacota o bot num arquivo só (ESM), com o Baileys e as bibliotecas dentro.
FROM node:24.21.0-bookworm-slim AS build
WORKDIR /bot
COPY package.json package-lock.json .npmrc ./
RUN --mount=type=cache,target=/root/.npm npm ci --ignore-scripts --no-audit --no-fund
COPY . .
RUN npm run build

# Runtime sem node_modules: só o pacote do bot.
FROM node:24.21.0-bookworm-slim
WORKDIR /bot
ENV NODE_ENV=production BOT_HOST=0.0.0.0 BOT_PORT=4005 BOT_DATA_DIR=/data
RUN mkdir /data && chown node:node /data
COPY --from=build --chown=node:node /bot/package.json package.json
COPY --from=build --chown=node:node /bot/dist dist
USER node
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 CMD node -e "fetch('http://127.0.0.1:4005/health',{signal:AbortSignal.timeout(3000)}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/main.js"]
