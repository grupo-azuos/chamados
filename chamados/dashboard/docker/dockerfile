# syntax=docker/dockerfile:1
FROM alpine:3.23 AS typst
ADD --checksum=sha256:a6d077d0a95eed5a2eba715b2dae06be954f624ccbf85758a03f389ded33118c https://github.com/typst/typst/releases/download/v0.15.1/typst-x86_64-unknown-linux-musl.tar.xz /tmp/typst.tar.xz
RUN apk add --no-cache xz \
  && tar -xJf /tmp/typst.tar.xz -C /tmp \
  && cp /tmp/typst-x86_64-unknown-linux-musl/typst /bin/typst

FROM node:24.21.0-bookworm-slim AS deps
WORKDIR /repo
COPY package.json package-lock.json ./
COPY shared/package.json shared/package.json
COPY server/package.json server/package.json
COPY client/package.json client/package.json
RUN --mount=type=cache,target=/root/.npm npm ci --ignore-scripts --no-audit --no-fund

FROM deps AS build
COPY . .
ARG VITE_API_URL=/api/v1
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build -w @template/shared && npm run build -w server --ignore-scripts && npm run build -w client

FROM deps AS production-deps
RUN mkdir -p server/node_modules && npm prune --omit=dev --ignore-scripts --workspace server --workspace @template/shared

FROM node:24.21.0-bookworm-slim AS app
WORKDIR /repo
ENV NODE_ENV=production API_PORT=3000
COPY --from=typst /bin/typst /usr/local/bin/typst
COPY --from=production-deps --chown=node:node /repo/node_modules node_modules
COPY --from=production-deps --chown=node:node /repo/server/node_modules server/node_modules
COPY --from=build --chown=node:node /repo/shared/package.json shared/package.json
COPY --from=build --chown=node:node /repo/shared/dist shared/dist
COPY --from=build --chown=node:node /repo/server/package.json server/package.json
COPY --from=build --chown=node:node /repo/server/dist server/dist
COPY --from=build --chown=node:node /repo/server/drizzle server/drizzle
COPY --from=build --chown=node:node /repo/client/dist client/dist
USER node
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=5s --start-period=45s --retries=3 CMD node -e "fetch('http://127.0.0.1:3000/api/health',{signal:AbortSignal.timeout(3000)}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server/dist/main.js"]
