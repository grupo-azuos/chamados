# Unir às variáveis do server (ou substituir server pelo site estático no brand).
# Prod e Homo são exports separados no Komodo. Nunca copiar credenciais entre eles.
# Este arquivo não é lido automaticamente: cadastre os valores no Infisical.
NODE_ENV=production
APP_ENV=homo
PUBLIC_DOMAIN=chamados.homo.grupoazuos.com.br
APP_REPLICAS=1
APP_CPU_LIMIT=1.0
APP_CPU_RESERVATION=0.10
APP_MEMORY_LIMIT=512M
APP_MEMORY_RESERVATION=128M
DATABASE_POOL_SIZE=5
DATABASE_MIGRATE_ON_START=false
TRUST_PROXY_HOPS=3
# No core/Prod são 2 saltos; no homo/Homo são 3 (ops, Caddy local e gateway).
# Origem alcançável pelo gateway, sem /api; o hostname deve corresponder ao issuer.
ADMIN_CONSOLE_URL=https://admin-console.homo.grupoazuos.com.br
ADMIN_CONSOLE_LOGIN_URL=https://admin-console.homo.grupoazuos.com.br
ADMIN_CONSOLE_COOKIE_PREFIX=azuos_homo
# Em Prod use o prefixo do emissor de Prod (ex.: azuos), sem compartilhar cookie de Homo.
# ADMIN_CONSOLE_CLIENT_SECRET=um_chamados_SECRETO_DO_AMBIENTE
# PostgreSQL e Valkey deste ambiente; o core usa os seus próprios valores em Prod.
# DATABASE_URL=postgresql://chamados:SECRET@postgres.homo.internal:5432/apps
# DATABASE_MIGRATION_URL=postgresql://APP_MIGRATOR:SECRET@postgres.homo.internal:5432/apps
# VALKEY_URL=redis://chamados:SECRET@100.85.230.136:6379/0
VALKEY_KEY_PREFIX=chamados:homo:
VALKEY_TIMEOUT_MS=1000
# API e bot compartilham somente a rede de integração, sem expor porta pública.
# BOT_API_URL=http://chamados-bot-homo_bot:4005
# BOT_SERVER_URL=https://chamados.homo.grupoazuos.com.br/api/v1
# BOT_API_TOKEN=CHANGE_ME_AT_LEAST_32_CHARACTERS
# BOT_SESSION_KEY=CHANGE_ME_64_HEX_CHARACTERS

# Borda de Homo no NetBird (ops); em Prod use o IP VPN da borda do core.
APP_EDGE_VPN_IP=EDGE_NETBIRD_IP_FOR_THIS_ENV

# Origens públicas para links/callbacks. Em Prod remover .homo. do hostname.
API_PUBLIC_URL=https://chamados.homo.grupoazuos.com.br
APP_PUBLIC_URL=https://chamados.homo.grupoazuos.com.br
API_CORS_ORIGIN=https://chamados.homo.grupoazuos.com.br

DEPLOY_DOMAIN=homo.grupoazuos.com.br
