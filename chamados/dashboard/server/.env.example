# Variáveis do server. Este arquivo é versionado; o `.env` ao lado NUNCA.
#
# O banco é o Postgres do Supabase do Grupo Azuos e os arquivos vão para o Storage dele, pela
# API S3 — o mesmo arranjo da Gestão de RH e do Paralegal. Os dois exigem credencial: sem
# `.env`, o server recusa subir e diz qual variável falta.
#
# Copie este arquivo para `.env` e troque os valores marcados com <...>.
#
# O que for segredo mora SÓ aqui. O client tem o `.env` dele, e tudo que está lá vira público
# no navegador — a separação é física, não uma regra que alguém precisa lembrar.

# ─────────────────────────────────────────────────────────────────────────────
# Banco — Postgres do Supabase
# ─────────────────────────────────────────────────────────────────────────────
# O mesmo Postgres dos outros sistemas da casa (homologação: o do `server/.env` do Paralegal).
# Formato: postgresql://usuario:senha@host:5432/postgres
#
# O banco é COMPARTILHADO: as tabelas deste sistema moram no schema `chamados`, e a lista de
# migrations é a própria (`drizzle.__chamados_migrations`). As migrations em `server/drizzle/`
# são aplicadas sozinhas quando o server sobe.
DATABASE_URL=<cole aqui a connection string do Postgres>

# O banco que `npm run test:e2e -w server` usa. Precisa ser um banco SÓ DELE: os testes
# ESVAZIAM as tabelas antes de rodar. Deixar em branco faz os testes E2E serem pulados, e não
# falharem. O caminho mais rápido é um Postgres descartável na sua máquina:
#   docker compose -f azuos-test-db.yml up -d
#   TEST_DATABASE_URL=postgresql://postgres:azuos-test@127.0.0.1:5433/azuos_test
TEST_DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Arquivos — storage pelo protocolo S3 (Supabase Storage)
# ─────────────────────────────────────────────────────────────────────────────
# As mesmas variáveis do Paralegal, da Gestão de RH e do admin-console. Trocar de provedor
# (Supabase, AWS, MinIO, R2) é trocar estes valores.
#
# O navegador envia e baixa os arquivos DIRETO neste endpoint, por link assinado (PUT para
# enviar, GET para baixar) — o arquivo nunca passa pela API. Por isso o endpoint é sempre o
# endereço PÚBLICO, nunca o IP da rede interna:
#   homologação: https://s3.homo.grupoazuos.com.br/storage/v1/s3
#   produção:    https://<projeto>.supabase.co/storage/v1/s3
S3_ENDPOINT=https://s3.homo.grupoazuos.com.br/storage/v1/s3
# homologação: local · produção: a região do projeto no Supabase
S3_REGION=local
# Bucket PRIVADO deste sistema.
S3_BUCKET=chamados
S3_ACCESS_KEY_ID=<chave de acesso S3>
S3_SECRET_ACCESS_KEY=<segredo S3>
# Supabase e MinIO endereçam o bucket no caminho (/bucket/chave).
S3_FORCE_PATH_STYLE=true
# Vazio, a assinatura usa o próprio S3_ENDPOINT (produção, AWS, MinIO, R2). Só na homologação:
# `s3.homo.grupoazuos.com.br:8001`. O Supabase self-hosted confere a assinatura com a porta do
# Kong, não com a do domínio público — sem isto, toda chamada volta `SignatureDoesNotMatch`.
S3_SIGNING_HOST=
#
# Os prazos dos links são fixos no código: envio 5 min, download 5 min.

# ─────────────────────────────────────────────────────────────────────────────
# Login — admin-console
# ─────────────────────────────────────────────────────────────────────────────
# Este sistema NÃO faz login. Quem identifica as pessoas é o admin-console, pelo proxy
# (forwardAuth do Traefik), que injeta os cabeçalhos x-forwarded-user-*.
#
# O endereço do admin-console que ESTE servidor alcança (pode ser o interno da rede do
# Coolify). Serve para ler quem tem acesso ao sistema — o seletor de responsável e a tela
# de Acessos. Sem ele, o sistema sobe, mas essas listas não carregam.
# ADMIN_CONSOLE_URL=http://localhost:3000
# O token de serviço do sistema, gerado na tela do sistema no admin-console (um_chamados_…).
# Aparece uma vez só lá. É segredo.
ADMIN_CONSOLE_TOKEN=
# O endereço PÚBLICO da tela de login do admin-console — para onde "Minha conta" leva.
# ADMIN_CONSOLE_LOGIN_URL=https://login.grupoazuos.com.br
# O prefixo dos cookies de sessão do admin-console (o COOKIE_NAME_PREFIX de lá; hoje azuos_homo).
# O servidor repassa só o <prefixo>_access_token ao admin-console para ler o perfil de quem abre
# chamado (telefone, departamento). Nunca o de renovação.
ADMIN_CONSOLE_COOKIE_PREFIX=azuos_homo
# A pessoa de desenvolvimento (dev@chamados.local) quando não há proxy na frente.
# Sem valor: ligada fora de produção, desligada em produção — e "true" em produção é recusado.
# Para ver o painel inteiro na sua máquina: npm run superadmin:promote -- dev@chamados.local
USER_MOCK=

# ─────────────────────────────────────────────────────────────────────────────
# API — tudo aqui tem padrão e pode ficar como está
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3005
API_CORS_ORIGIN=http://localhost:5005
API_LOG_LEVEL=debug

# ─────────────────────────────────────────────────────────────────────────────
# Trava de requisição — quantas chamadas um mesmo IP pode fazer
# ─────────────────────────────────────────────────────────────────────────────
# Estourar o limite devolve 429 com a mensagem "Muitas requisições em pouco tempo".
# O padrão é folgado porque a tela faz várias chamadas por clique; quem estiver sob abuso
# aperta aqui, sem mexer no código.
API_RATE_LIMIT_TTL_SECONDS=60
API_RATE_LIMIT=300

# O limite só do webhook do UniFi, bem mais apertado: aquela porta é pública (o controlador
# não tem login) e um controlador de verdade manda um alerta por queda, não trezentos por minuto.
API_WEBHOOK_RATE_LIMIT=12

# Quantos proxies existem entre a internet e a API. Isto decide QUEM a trava conta.
#   0 = desenvolvimento, o navegador fala direto com a API (padrão).
#   1 = produção atrás de UM Traefik (é o caso do Coolify).
# Deixar 0 em produção faz o mundo inteiro dividir um único balde, e uma pessoa ocupada
# tranca a API para as outras. Aumentar "por segurança" faz o contrário: cada salto a mais é
# um salto em que o endereço passa a ser o que o cliente DISSE ser, e a trava deixa de valer.
API_TRUST_PROXY_HOPS=0

# O segredo do webhook do UniFi — só se você for receber os alertas de rede automaticamente.
# O controlador não tem login: ele prova quem é apresentando este valor na URL do webhook
# (https://SEU-ENDERECO/api/network/webhook?token=SEGREDO). Sem esta variável, a rota recusa
# tudo — é melhor a integração ficar fora do ar do que aberta para qualquer um.
# Invente um valor longo, só para isso. Quem não usa UniFi registra as quedas pela tela.
# UNIFI_WEBHOOK_TOKEN=troque-este-valor-por-um-segredo-longo

# GitHub - integração dos Sistemas (opcional)
#
# Sem esta variável o sistema funciona normalmente, só que SEM escrever no GitHub:
#   - chamado de um sistema com link de repositório NÃO abre issue (o log avisa e segue);
#   - "Sincronizar" lê os Pull Requests só de repositórios PÚBLICOS e com o limite baixo da API
#     anônima (60 chamadas por hora).
#
# Com ela:
#   - todo chamado aberto num sistema vira uma issue no repositório dele, em segundo plano
#     (a resposta da tela não espera o GitHub), e o número da issue aparece no card do Kanban
#     e na linha do tempo do sistema;
#   - os Pull Requests entram na linha do tempo, inclusive de repositórios privados.
#
# Crie em GitHub -> Settings -> Developer settings -> Fine-grained tokens, escolhendo só os
# repositórios dos sistemas, com permissões "Issues: Read and write" e "Pull requests: Read".
# O token é segredo: mora só neste arquivo, nunca no `.env` do client.
# GITHUB_TOKEN=github_pat_troque-este-valor

# GitHub App: vinculação obrigatória por usuário no módulo Sistema.
# No GitHub, registre a Redirect URI exatamente igual a GITHUB_OAUTH_REDIRECT_URI.
# Desenvolvimento: http://localhost:5005/api/integrations/github/callback
# Produção: https://chamados.grupoazuos.com.br/api/integrations/github/callback
# FRONTEND_URL é a origem do CLIENTE; após validar o callback, abre /system/dashboard.
# Use o Client ID do GitHub App (não o App ID).
# GITHUB_OAUTH_CLIENT_ID=seu-client-id
# GITHUB_OAUTH_CLIENT_SECRET=seu-client-secret
# GITHUB_OAUTH_REDIRECT_URI=http://localhost:5005/api/integrations/github/callback
# GITHUB_OAUTH_FRONTEND_URL=http://localhost:5005
# Chave AES-256 em hexadecimal (64 caracteres), permanente por instalação.
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# GITHUB_OAUTH_ENCRYPTION_KEY=sua-chave-de-64-caracteres
# Tokens e refresh tokens ficam criptografados no banco. Nunca configure segredos no client.

# Integração compartilhada: GitHub App instalado na organização.
# Issues: Read and write; Pull requests: Read-only; Metadata: Read-only.
# PRIVATE_KEY aceita PEM com quebras de linha escapadas como \n.
# GITHUB_APP_ID=123456
# GITHUB_APP_INSTALLATION_ID=12345678
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
