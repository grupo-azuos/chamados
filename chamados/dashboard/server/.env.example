# Contrato local de configuração. Versionado; nunca copiar segredos reais para este arquivo.
# Em Prod/Homo o .komodo/komodo.toml exporta o Infisical ANTES de migration/deploy.
# Unir com docker/.env.example no Infisical. Produção usa core; Homo usa somente homo.
# ADMIN_CONSOLE_CLIENT_SECRET é trocado por JWT no emissor; nunca enviado cru às APIs.
# SQLite é exclusivo do MVP do template. Nos demais projetos o banco é PostgreSQL.
# Variáveis opcionais estão comentadas; descomente somente ao configurar a integração.


# APP
APP_ENV=dev

# VALKEY
# VALKEY_URL=redis://default:CHANGE_ME@127.0.0.1:6379/0
VALKEY_KEY_PREFIX=chamados:development
VALKEY_TIMEOUT_MS=1000

# DATABASE
DATABASE_MIGRATE_ON_START=false
DATABASE_MIGRATION_URL=postgresql://chamados_migrator:CHANGE_ME@127.0.0.1:5432/chamados
DATABASE_POOL_SIZE=5

# TRUST
TRUST_PROXY_HOPS=0

# GITHUB
# GITHUB_APP_ID=123456
# GITHUB_APP_INSTALLATION_ID=12345678
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_OAUTH_CLIENT_ID=your-client-id
# GITHUB_OAUTH_CLIENT_SECRET=your-client-secret
# GITHUB_OAUTH_REDIRECT_URI=http://localhost:5005/api/integrations/github/callback
# GITHUB_OAUTH_FRONTEND_URL=http://localhost:5005
# GITHUB_OAUTH_ENCRYPTION_KEY=your-64-char-key

# BOT
# BOT_API_URL=
# BOT_API_TOKEN=

# WHATSAPP
# WHATSAPP_DAILY_LIMIT=

# APP
# APP_PUBLIC_URL=

# NODE
NODE_ENV=development

# API
API_PORT=3005
API_CORS_ORIGIN=http://localhost:5005
API_LOG_LEVEL=debug
API_RATE_LIMIT_TTL_SECONDS=60
API_RATE_LIMIT=300
API_WEBHOOK_RATE_LIMIT=12

# DATABASE
DATABASE_URL=postgresql://chamados:CHANGE_ME@127.0.0.1:5432/chamados

# TEST
# TEST_DATABASE_URL=

# S3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=chamados
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true
# S3_SIGNING_HOST=

# UNIFI
UNIFI_WEBHOOK_TOKEN=replace-with-a-long-secret

# ADMIN
ADMIN_CONSOLE_URL=http://localhost:3000
# ADMIN_CONSOLE_CLIENT_SECRET=um_chamados_CHANGE_ME
ADMIN_CONSOLE_TIMEOUT_MS=4000
ADMIN_CONSOLE_LOGIN_URL=http://localhost:5000
ADMIN_CONSOLE_COOKIE_PREFIX=azuos

# USER
USER_MOCK=false
# USER_MOCK_ID=
# USER_MOCK_EMAIL=
# USER_MOCK_NAME=

# CA PEM do PostgreSQL gerenciado; pode conter \n escapado. Nunca usar rejectUnauthorized=false.
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Em dev, as rotinas podem rodar no processo local. No Swarm o Compose separa web/worker.
BACKGROUND_JOBS_ENABLED=true
