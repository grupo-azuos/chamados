<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!-- wixl usa o formato WiX v3 como linguagem, sem depender do compilador WiX. -->
  <Product Id="*" Name="Azuos Agent" Manufacturer="Azuos" Version="$(var.Version)"
           UpgradeCode="E7C8A7F8-AC5E-4E7C-852B-55FF1B218B93" Language="1046" Codepage="1252">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" />
    <MajorUpgrade DowngradeErrorMessage="Uma versão mais recente do Azuos Agent já está instalada." />
    <Media Id="1" Cabinet="agent.cab" EmbedCab="yes" />
    <Condition Message="Este instalador exige Windows 10 1809 ou superior, ou Windows 11, em x64.">VersionNT64 AND WindowsBuild &gt;= 17763</Condition>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="AzuosFolder" Name="Azuos">
          <Directory Id="INSTALLFOLDER" Name="Agent">
            <Component Id="DesktopApp" Guid="*" Win64="yes">
              <File Id="AgentExe" Source="$(var.BinDir)/Azuos Agent.exe" KeyPath="yes" />
              <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="AzuosAgent" Value="&quot;[#AgentExe]&quot;" Type="string" />
            </Component>
            <Component Id="AgentService" Guid="*" Win64="yes">
              <File Id="ServiceExe" Source="$(var.BinDir)/azuos-agent-service.exe" KeyPath="yes" />
              <ServiceInstall Id="InstallService" Name="AzuosAgent" DisplayName="Azuos Agent" Description="Coleta de métricas e atualização automática do agente Azuos." Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem" Vital="yes">
                <ServiceDependency Id="Tcpip" />
              </ServiceInstall>
              <ServiceControl Id="ControlService" Name="AzuosAgent" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
            </Component>
            <Component Id="SetupFiles" Guid="*" Win64="yes">
              <File Id="ConfigureMachine" Source="$(var.SourceDir)/configure-machine.ps1" KeyPath="yes" />
              <File Id="InstallCertificate" Source="$(var.SourceDir)/install-certificate.ps1" />
            </Component>
          </Directory>
        </Directory>
      </Directory>
      <Directory Id="CommonAppDataFolder">
          <Directory Id="AGENTDATA" Name="AzuosAgent">
            <Component Id="MachineDirectory" Guid="595EFC25-75C4-4284-A9DE-DC9BE4C967B4" Permanent="yes" Win64="yes">
              <CreateFolder />
            </Component>
          </Directory>
      </Directory>
      <Directory Id="SystemFolder" />
    </Directory>
    <Feature Id="Main" Title="Azuos Agent" Level="1">
      <ComponentRef Id="DesktopApp" />
      <ComponentRef Id="AgentService" />
      <ComponentRef Id="SetupFiles" />
      <ComponentRef Id="MachineDirectory" />
    </Feature>
  </Product>
</Wix>
