{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.workingDirectories": [
    { "directory": "chamados/dashboard/shared", "changeProcessCWD": true },
    { "directory": "chamados/dashboard/server", "changeProcessCWD": true },
    { "directory": "chamados/dashboard/client", "changeProcessCWD": true }
  ],
  "prettier.requireConfig": true,
  "typescript.tsdk": "chamados/dashboard/node_modules/typescript/lib",
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "files.eol": "\n",
  "files.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/coverage": true,
    "**/reports": true,
    "**/storybook-static": true,
    "**/.husky/_": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/coverage": true,
    "**/reports": true,
    "**/storybook-static": true,
    "**/routeTree.gen.ts": true,
    "**/drizzle/meta": true
  },
  "explorer.fileNesting.patterns": {
    "*.component.tsx": "${capture}.stories.tsx, ${capture}.test.tsx",
    "*.ts": "${capture}.test.ts",
    "*.tsx": "${capture}.test.tsx",
    "package.json": "package-lock.json"
  }
}
